// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id              String         @id @default(uuid())
  username        String         @unique
  phone_number    String         @unique
  image           String?
  is_verified     Boolean        @default(false)
  neighborhood    neighborhoods? @relation(fields: [neighborhood_id], references: [id])
  neighborhood_id Int?
  building        buildings?     @relation(fields: [building_id], references: [id])
  building_id     Int?
  followers_count Int            @default(0)
  following_count Int            @default(0)
  chat_token      String?
  fcm_token       String?
  created_at      DateTime       @default(now())
  tags            Json?
  blocked_users   String[]       @default([])

  posts                    posts[]
  comments                 comments[]
  chat_messages            chat_messages[]
  followed_by              user_following[]           @relation("follower_user_id")
  following                user_following[]           @relation("following_user_id")
  likes                    post_likes[]
  liked_comments           comment_likes[]
  tokens                   tokens[]
  reported_posts           reported_posts[]
  reported_comments        reported_comments[]
  building_change_requests building_change_requests[]
  notification_for_user    notifications[]            @relation("for_user_id")
  notification_from_user   notifications[]            @relation("from_user_id")
}

model tokens {
  id          Int       @id @default(autoincrement())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  type        TokenType
  phone_token String?   @unique
  valid       Boolean   @default(true)
  expiration  DateTime?
  tags        Json?

  user_id String
  user    users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum TokenType {
  PHONE
}

model neighborhoods {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  tags       Json?

  users     users[]
  buildings buildings[]
  posts     posts[]
}

model buildings {
  id              Int           @id @default(autoincrement())
  address         String        @unique
  neighborhood    neighborhoods @relation(fields: [neighborhood_id], references: [id])
  neighborhood_id Int
  created_at      DateTime      @default(now())
  tags            Json?

  users         users[]
  chat_messages chat_messages[]
}

model posts {
  id                Int           @id @default(autoincrement())
  user              users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           String
  neighborhood      neighborhoods @relation(fields: [neighborhood_id], references: [id])
  neighborhood_id   Int
  text_content      String?
  image_url         String        @default("")
  likes_count       Int           @default(0)
  comments_count    Int           @default(0)
  hidden_from_users String[]         @default([])
  created_at        DateTime      @default(now())
  tags              Json?

  comments       comments[]
  likes          post_likes[]
  reported_posts reported_posts[]
  notifications  notifications[]  @relation("for_post_id")

  @@index([neighborhood_id, created_at], name: "idx_post_neighborhood_created_at")
  @@index([user_id, created_at], name: "idx_post_user_created_at")
}

model reported_posts {
  id                Int      @id @default(autoincrement())
  post              posts    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id           Int
  user              users    @relation(fields: [user_id_reporting], references: [id], onDelete: Cascade)
  user_id_reporting String
  reason            String?
  created_at        DateTime @default(now())
  tags              Json?
}

model post_likes {
  id         Int     @id @default(autoincrement())
  user_id    String
  post_id    Int
  is_dislike Boolean @default(false)
  user       users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post       posts   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
}

model comments {
  id                Int                 @id @default(autoincrement())
  post              posts               @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id           Int
  user              users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           String
  text_content      String
  likes_count       Int                 @default(0)
  created_at        DateTime            @default(now())
  tags              Json?
  parent_comment    comments?           @relation("replies", fields: [parent_comment_id], references: [id])
  parent_comment_id Int?
  replies           comments[]          @relation("replies")
  likedBy           comment_likes[]
  reported_comments reported_comments[]
  notifications     notifications[]     @relation("for_comment_id")

  @@index([post_id, likes_count], name: "idx_comment_post_likes")
  @@index([parent_comment_id], name: "idx_comment_parent_comment")
}

model reported_comments {
  id                Int      @id @default(autoincrement())
  comment           comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_id        Int
  user              users    @relation(fields: [user_id_reporting], references: [id], onDelete: Cascade)
  user_id_reporting String
  reason            String?
  created_at        DateTime @default(now())
  tags              Json?
}

model comment_likes {
  id         Int      @id @default(autoincrement())
  user_id    String
  comment_id Int
  is_dislike Boolean  @default(false)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment    comments @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, comment_id])
}

model chat_messages {
  id           Int       @id @default(autoincrement())
  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  building     buildings @relation(fields: [building_id], references: [id])
  building_id  Int
  text_content String
  created_at   DateTime  @default(now())
  tags         Json?
}

model user_following {
  id                Int      @id @default(autoincrement())
  follower_user     users    @relation("follower_user_id", fields: [follower_user_id], references: [id], onDelete: Cascade)
  follower_user_id  String
  following_user    users    @relation("following_user_id", fields: [following_user_id], references: [id], onDelete: Cascade)
  following_user_id String
  created_at        DateTime @default(now())
  tags              Json?

  @@unique([follower_user_id, following_user_id], name: "idx_userfollowing_relationship")
}

model building_change_requests {
  id              Int      @id @default(autoincrement())
  user            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id         String
  address_request String
  created_at      DateTime @default(now())
  tags            Json?
}

model notifications {
  id             Int       @id @default(autoincrement())
  for_user       users     @relation("for_user_id", fields: [for_user_id], references: [id], onDelete: Cascade)
  for_user_id    String
  for_post       posts?    @relation("for_post_id", fields: [for_post_id], references: [id])
  for_post_id    Int?
  for_comment    comments? @relation("for_comment_id", fields: [for_comment_id], references: [id])
  for_comment_id Int?
  from_user      users?    @relation("from_user_id", fields: [from_user_id], references: [id])
  from_user_id   String?
  title          String
  message        String
  read           Boolean   @default(false)
  created_at     DateTime  @default(now())
  tags           Json?

  @@index([for_user_id, created_at], name: "idx_notification_for_user_created_at")
}

model account_deletion_requests {
  id         Int      @id @default(autoincrement())
  user_id    String
  username   String?
  reason     String?
  created_at DateTime @default(now())
  tags       Json?
}

model log_entries {
  id         Int      @id @default(autoincrement())
  log        String
  created_at DateTime @default(now())
  tags       Json?
}
