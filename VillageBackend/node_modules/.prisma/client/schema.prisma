// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider  = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id             Int             @id @default(autoincrement())
  username       String          @unique
  email          String          @unique
  image          String?
  isVerified     Boolean         @default(false)
  neighborhood   neighborhoods?  @relation(fields: [neighborhoodID], references: [id])
  neighborhoodID Int?
  building       buildings?      @relation(fields: [buildingID], references: [id])
  buildingID     Int?
  followersCount Int             @default(0)
  followingCount Int             @default(0)
  createdAt      DateTime        @default(now())
  tags           Json?
  
  posts          posts[]
  comments       comments[]
  chatMessages   chat_messages[]
  followedBy     user_following[]  @relation("followerUserID")
  following      user_following[]  @relation("followingUserID")
  likes          post_likes[]
  likedComments  comment_likes[]
}

model neighborhoods {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  createdAt      DateTime       @default(now())
  tags           Json?

  users          users[]
  buildings      buildings[]
  posts          posts[]
}


model buildings {
  id             Int            @id @default(autoincrement())
  address        String
  neighborhood   neighborhoods  @relation(fields: [neighborhoodID], references: [id])
  neighborhoodID Int
  createdAt      DateTime       @default(now())
  tags           Json?
  
  users          users[]
  chatMessages   chat_messages[]
}

model posts {
  id             Int             @id @default(autoincrement())
  user           users           @relation(fields: [userID], references: [id])
  userID         Int
  neighborhood   neighborhoods   @relation(fields: [neighborhoodID], references: [id])
  neighborhoodID Int
  textContent    String?
  imageURL       String          @default("")
  likesCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  tags           Json?

  comments       comments[]
  likes          post_likes[]

  @@index([neighborhoodID, createdAt], name: "idx_post_neighborhood_createdat")
  @@index([userID, createdAt], name: "idx_post_user_createdat")
}

model post_likes {
  id       Int     @id @default(autoincrement())
  userID   Int
  postID   Int
  user     users   @relation(fields: [userID], references: [id])
  post     posts   @relation(fields: [postID], references: [id])

  @@unique([userID, postID])
}

model comments {
  id              Int             @id @default(autoincrement())
  post            posts           @relation(fields: [postID], references: [id])
  postID          Int
  user            users           @relation(fields: [userID], references: [id])
  userID          Int
  textContent     String
  likesCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  tags            Json?
  parentComment   comments?       @relation("Replies", fields: [parentCommentID], references: [id])
  parentCommentID Int?
  replies         comments[]      @relation("Replies")
  likedBy         comment_likes[]

  @@index([postID, likesCount], name: "idx_comment_post_likes")
  @@index([parentCommentID], name: "idx_comment_parent_comment")
}

model comment_likes {
  id          Int       @id @default(autoincrement())
  userID      Int
  commentID   Int
  user        users     @relation(fields: [userID], references: [id])
  comment     comments  @relation(fields: [commentID], references: [id])

  @@unique([userID, commentID])
}

model chat_messages {
  id             Int             @id @default(autoincrement())
  user           users           @relation(fields: [userID], references: [id])
  userID         Int
  building       buildings       @relation(fields: [buildingID], references: [id])
  buildingID     Int
  textContent    String
  createdAt      DateTime        @default(now())
  tags           Json?
}

model user_following {
  id                 Int       @id @default(autoincrement())
  followerUser       users     @relation("followerUserID", fields: [followerUserID], references: [id])
  followerUserID     Int
  followingUser      users     @relation("followingUserID", fields: [followingUserID], references: [id])
  followingUserID    Int
  createdAt          DateTime  @default(now())
  tags               Json?

  @@index([followerUserID, followingUserID], name: "idx_userfollowing_relationship")
}
